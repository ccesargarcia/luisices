# Firebase Configuration
#
# Copie este arquivo para .env.local e preencha com suas credenciais do Firebase
# Obtenha estas informações em: https://console.firebase.google.com
#
# Passos:
# 1. Acesse Firebase Console
# 2. Selecione seu projeto
# 3. Vá em Project Settings (⚙️) > General
# 4. Role até "Your apps" e clique no ícone Web (</>)
# 5. Copie as credenciais do firebaseConfig

# -------------------------------------------------------------------
# AMBIENTE LOCAL (development) — aponta para o projeto Firebase de DEV
# -------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-dev-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-dev-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-dev-project-id
VITE_FIREBASE_DATABASE_URL=https://your-dev-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your-dev-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-dev-sender-id
VITE_FIREBASE_APP_ID=your-dev-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-dev-measurement-id
# CDN Custom Domain (Cloudflare Worker para Firebase Storage)
VITE_STORAGE_CDN_URL=https://cdn-dev.luisices.com.br
# Custom Domain para Cloud Functions (Cloudflare Worker / Reverse Proxy)
VITE_FUNCTIONS_CUSTOM_DOMAIN=https://api.dev.luisices.com.br

# -------------------------------------------------------------------
# GitHub Secrets necessários para CI/CD
# -------------------------------------------------------------------
#
# PRODUÇÃO (branch main → luisices.com.br/)
# Adicione estes secrets em: Settings > Secrets > Actions
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_STORAGE_BUCKET
#   VITE_FIREBASE_MESSAGING_SENDER_ID
#   VITE_FIREBASE_APP_ID
#   VITE_FIREBASE_MEASUREMENT_ID
#   VITE_STORAGE_CDN_URL (ex: https://cdn.luisices.com.br)
#
# DEV (branch develop → dev.luisices.com.br via Firebase Hosting)
# Adicione estes secrets em: Settings > Secrets > Actions
#   DEV_VITE_FIREBASE_API_KEY
#   DEV_VITE_FIREBASE_AUTH_DOMAIN
#   DEV_VITE_FIREBASE_PROJECT_ID
#   DEV_VITE_FIREBASE_STORAGE_BUCKET
#   DEV_VITE_FIREBASE_MESSAGING_SENDER_ID
#   DEV_VITE_FIREBASE_APP_ID
#   DEV_VITE_FIREBASE_MEASUREMENT_ID
#   DEV_VITE_STORAGE_CDN_URL (ex: https://cdn-dev.luisices.com.br)
#   FIREBASE_SERVICE_ACCOUNT_DEV  ← JSON da service account (Firebase Console > Project Settings > Service Accounts)
#   DEV_ORDER_TRACKING_ENCRYPTION_KEY (chave base64 de 32 bytes; mantenha-a estável para preservar os links)
#   PROD_ORDER_TRACKING_ENCRYPTION_KEY (chave base64 de 32 bytes, distinta da chave de Dev)

# Os tokens dos links de acompanhamento são cifrados para poderem ser consultados
# novamente por administradores e por quem os criou. Configure uma chave aleatória
# de 32 bytes em base64 no Secret Manager do projeto e no arquivo functions/.secret.local
# (este último é local e ignorado pelo Git):
#   firebase functions:secrets:set ORDER_TRACKING_ENCRYPTION_KEY
