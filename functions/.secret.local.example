# Exemplo de Secrets para o Firebase Functions Emulator
# Para rodar os emuladores localmente ou em testes sem chamar o Google Cloud Secret Manager:
# cp functions/.secret.local.example functions/.secret.local

RESEND_API_KEY=mock-resend-key
EVOLUTION_API_KEY=mock-evolution-key
RESEND_WEBHOOK_SECRET=mock-webhook-secret
GEMINI_API_KEY=mock-gemini-key
SUPERFRETE_SANDBOX_TOKEN=mock-superfrete-token
ORIGIN_SECRET=mock-origin-secret
ALEXA_IDENTITY_HMAC_KEY=mock-alexa-hmac-key
