{
  "rules": {
    "status": {
      // Somente admin pode ler tudo. Usuários comuns só leem/escrevem o próprio status.
      ".read": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        // Leitura do próprio status
        ".read": "auth != null && auth.uid === $uid",
        // Escrita restrita ao próprio usuário e apenas se a conta não estiver revogada/inativa (auth.token.active !== false se aplicável)
        ".write": "auth != null && auth.uid === $uid",
        
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline' || newData.val() === 'away'"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "lastOnline": {
          ".validate": "newData.isNumber()"
        },
        "connections": {
          "$connectionId": {
            ".validate": "newData.isBoolean()"
          }
        },
        // Rejeita campos desconhecidos
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}
