rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfis legados sem active continuam válidos; desativação explícita bloqueia acesso.
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && (!('active' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true);
    }

    // Helper function para verificar se o usuário é o dono do recurso
    function isOwner(userId) {
      return isActiveUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isActiveUser()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && ('role' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && ('role' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'funcionario'
        && (!('active' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true);
    }

    function isAssignedEmployee(assignedTo) {
      return assignedTo == request.auth.uid && isActiveEmployee();
    }

    function isAssignedEmployeeEditor(assignedTo) {
      return isAssignedEmployee(assignedTo)
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('orders' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders == true)
          || (
            'orders' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders is map
            && 'edit' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders.edit == true
          )
        );
    }

    function isAssignedEmployeeDeleter(assignedTo) {
      return isAssignedEmployee(assignedTo)
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('orders' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders == true)
          || (
            'orders' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders is map
            && 'delete' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders.delete == true
          )
        );
    }

    function employeeHasPricingView() {
      return isActiveEmployee()
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing == true)
          || (
            'pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing is map
            && 'view' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing.view == true
          )
        );
    }

    function employeeHasPricingCreate() {
      return isActiveEmployee()
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing == true)
          || (
            'pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing is map
            && 'create' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing.create == true
          )
        );
    }

    function employeeHasPricingEdit() {
      return isActiveEmployee()
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing == true)
          || (
            'pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing is map
            && 'edit' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing.edit == true
          )
        );
    }

    function employeeHasPricingDelete() {
      return isActiveEmployee()
        && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
        && (
          ('pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
           && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing == true)
          || (
            'pricing' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing is map
            && 'delete' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.pricing.delete == true
          )
        );
    }

    // Regras para pedidos (orders)
    match /orders/{orderId} {
      allow read: if ('userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin()
        || ('assignedTo' in resource.data && isAssignedEmployee(resource.data.assignedTo));
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isAdmin()
        || (
          'userId' in resource.data && isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
        )
        || (
          'assignedTo' in resource.data
          && isAssignedEmployeeEditor(resource.data.assignedTo)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.assignedTo == resource.data.assignedTo
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt'])
            || isAssignedEmployeeDeleter(resource.data.assignedTo)
          )
        );
      allow delete: if ('userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin()
        || ('assignedTo' in resource.data && isAssignedEmployeeDeleter(resource.data.assignedTo));
    }

    // Regras para histórico financeiro de vendas (salesLedger)
    match /salesLedger/{saleId} {
      allow read: if request.auth != null && (
        (resource != null && (
          ('userId' in resource.data && isOwner(resource.data.userId))
          || isAdmin()
          || ('assignedTo' in resource.data && isAssignedEmployee(resource.data.assignedTo))
        ))
        || (resource == null && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/orders/$(saleId))
            && (
              isOwner(get(/databases/$(database)/documents/orders/$(saleId)).data.userId)
              || ('assignedTo' in get(/databases/$(database)/documents/orders/$(saleId)).data && isAssignedEmployee(get(/databases/$(database)/documents/orders/$(saleId)).data.assignedTo))
            )
          )
        ))
      );
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.userId == resource.data.userId
        && (isOwner(resource.data.userId) || (
          'assignedTo' in resource.data
          && isAssignedEmployeeEditor(resource.data.assignedTo)
          && request.resource.data.assignedTo == resource.data.assignedTo
        ))
      );
      allow delete: if ('userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin();
    }

    // Regras para clientes (customers)
    match /customers/{customerId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.customers.view == true);
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.customers.edit == true);
      allow delete: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.customers.delete == true);
    }

    // Regras para orçamentos (quotes)
    match /quotes/{quoteId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.quotes.view == true);
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.quotes.edit == true);
      allow delete: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.quotes.delete == true);
    }

    // Regras para produtos (products)
    match /products/{productId} {
      allow read: if resource.data.isPublic == true
        || isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.products.view == true);
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.products.edit == true);
      allow delete: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.products.delete == true);
    }

    // Regras para galeria de artes (gallery)
    match /gallery/{itemId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.view == true);
      allow create: if isOwner(request.resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.create == true);
      allow update, delete: if isOwner(resource.data.userId)
        || isAdmin()
        || (isActiveEmployee() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.delete == true);
    }

    // Regras para configurações de usuário (users)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Regras para insumos e matérias-primas (supplies)
    match /supplies/{supplyId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && isOwner(resource.data.userId))
      );
      allow create: if isOwner(request.resource.data.userId) || isAdmin() || employeeHasPricingCreate();
      allow update: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingEdit();
      allow delete: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para histórico de compras de insumos (purchaseHistory)
    match /purchaseHistory/{purchaseId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && isOwner(resource.data.userId))
        || (resource == null && purchaseId.matches('^' + request.auth.uid + '_.*'))
      );
      allow create: if isOwner(request.resource.data.userId) || isAdmin() || employeeHasPricingCreate();
      allow update: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingEdit();
      allow delete: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para fichas técnicas de precificação (pricingRecipes)
    match /pricingRecipes/{recipeId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && isOwner(resource.data.userId))
      );
      allow create: if isOwner(request.resource.data.userId) || isAdmin() || employeeHasPricingCreate();
      allow update: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingEdit();
      allow delete: if isOwner(resource.data.userId) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para configurações do ateliê (pricingSettings)
    match /pricingSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin() || employeeHasPricingView();
      allow write: if isOwner(userId) || isAdmin() || employeeHasPricingEdit();
    }

    // Regras para acompanhamento de produção (productionTracking)
    match /productionTracking/{trackingId} {
      allow read: if ('userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin()
        || employeeHasPricingView();
      allow create: if (isOwner(request.resource.data.userId) || isAdmin() || employeeHasPricingCreate())
        && request.resource.data.userId is string
        && request.resource.data.recipeId is string;
      allow update: if ('userId' in resource.data && isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId)
        || isAdmin()
        || (
          'userId' in resource.data && employeeHasPricingEdit()
          && request.resource.data.userId == resource.data.userId
        );
      allow delete: if ('userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin()
        || employeeHasPricingDelete();
    }

    // Perfis de usuário do sistema de permissões
    match /userProfiles/{uid} {
      // Leitura: usuário lê apenas o próprio perfil; admin e funcionários ativos leem todos para colaboração na equipe
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isActiveEmployee());

      // Criação: somente administradores (convites criam perfis server-side via Admin SDK)
      allow create: if isAdmin();

      // Atualização: admin pode alterar tudo;
      // usuário comum pode atualizar seus dados (nome, etc), mas não pode mudar seu role, permissions nem seu active (evita auto-promoção)
      allow update: if request.auth != null && (
        isAdmin()
        || (
          request.auth.uid == uid && isActiveUser()
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'role', 'active', 'permissions', 'createdBy', 'createdAt'])
        )
      );

      // Deleção: somente admins
      allow delete: if isAdmin();
    }

    // Regras para Central de E-mails Resend (estritamente restrito a administradores)
    match /receivedEmails/{emailId} {
      allow read, write: if isAdmin();
    }

    match /sentEmails/{emailId} {
      allow read, write: if isAdmin();
    }

    // Regras para configurações públicas da loja / catálogo online
    match /storeSettings/{docId} {
      allow read: if true;
      // Escrita restrita a administradores ou usuários ativos com permissão explícita de loja ou configurações
      allow write: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.store == true
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.settings == true
            ))
      );
    }

    // Regras para produtos da vitrine da lojinha pública online (storeProducts)
    match /storeProducts/{productId} {
      // Leitura pública irrestrita para catálogo online (/catalogo)
      allow read: if true;

      // Criação permitida para administradores ou usuários ativos com permissão de criação em loja
      allow create: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.storeProducts.create == true
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.store == true
            ))
      );

      // Atualização permitida para administradores, donos do produto ou usuários com permissão
      allow update: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || (isOwner(resource.data.userId) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.storeProducts.edit != false)
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.storeProducts.edit == true
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.store == true
            ))
      );

      // Exclusão permitida para administradores, donos do produto ou usuários ativos com permissão de exclusão
      allow delete: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || (isOwner(resource.data.userId) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.storeProducts.delete != false)
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.storeProducts.delete == true
            ))
      );
    }

    // Regras para histórico de pedidos da Lojinha Pública (catalogOrders)
    // Criação aberta ao público ocorre via Cloud Function submitPublicCatalogOrder (Admin SDK)
    match /catalogOrders/{orderId} {
      // Bloquear criação direta no cliente por qualquer usuário; pedidos públicos devem passar estritamente pela Cloud Function submitPublicCatalogOrder
      allow create: if false;

      // Leitura permitida para administradores ou membros autorizados
      allow read: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.store == true
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders.view == true
            ))
      );

      // Atualização e exclusão restritas a administradores ou gestores da loja
      allow update, delete: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
            && (
              get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
              || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.store == true
            ))
      );
    }

    // Regras para Central de Atendimento WhatsApp (whatsapp_chats e whatsapp_messages)
    function canAccessWhatsApp() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
        && (
          isAdmin()
          || (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'user'
              && (!('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
                  || !('whatsapp' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions)
                  || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.whatsapp != false))
          || (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'funcionario'
              && ('permissions' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
              && ('whatsapp' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions)
              && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.whatsapp == true)
        );
    }

    match /whatsapp_chats/{chatId} {
      allow read, write: if canAccessWhatsApp();
    }

    match /whatsapp_messages/{messageId} {
      allow read, write: if canAccessWhatsApp();
    }

    // ─── Integração Alexa (Coleções Técnicas Internas) ────────────────────────
    // Bloqueio total de leitura e escrita direta pelo SDK cliente web/mobile.
    // Todas as operações devem passar exclusivamente por Cloud Functions v2 (Admin SDK).
    match /integrationSettings/alexa {
      allow read, write: if false;
    }
    match /alexaPermissions/{uid} {
      allow read, write: if false;
    }
    match /alexaBindings/{bindingKey} {
      allow read, write: if false;
    }
    match /alexaPairings/{codeHmac} {
      allow read, write: if false;
    }
    match /alexaDrafts/{draftId} {
      allow read, write: if false;
    }
    match /alexaRequests/{requestKey} {
      allow read, write: if false;
    }
    match /alexaCommits/{draftId} {
      allow read, write: if false;
    }
    match /alexaRateLimits/{bucketKey} {
      allow read, write: if false;
    }
    match /alexaAudit/{eventId} {
      allow read, write: if false;
    }
  }
}

