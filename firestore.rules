rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Perfis legados sem active continuam válidos; desativação explícita ou revogação de tokens bloqueia acesso.
    function isActiveProfile(profile) {
      return profile.get('active', true)
        && (!('tokensValidAfterTime' in profile)
          || request.auth.token.auth_time > profile.tokensValidAfterTime);
    }

    function isActiveUser() {
      return request.auth != null
        && isActiveProfile(get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data);
    }

    // Helper function para verificar se o usuário é o dono do recurso
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId && isActiveUser();
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'admin'
        && isActiveUser();
    }

    function isActiveEmployee() {
      return request.auth != null
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'funcionario'
        && isActiveUser();
    }

    function isAssignedEmployee(assignedTo) {
      return assignedTo == request.auth.uid && isActiveEmployee();
    }

    function getEmployeePermissions() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('permissions', {});
    }

    function hasPerm(permField, action) {
      return (permField is bool && permField)
        || (permField is map && permField.get(action, false));
    }

    function userHasPerm(module, action) {
      return isActiveUser()
        && (isAdmin() || hasPerm(getEmployeePermissions().get(module, false), action));
    }

    function isAssignedEmployeeEditor(assignedTo) {
      return isAssignedEmployee(assignedTo)
        && userHasPerm('orders', 'edit');
    }

    function isAssignedEmployeeDeleter(assignedTo) {
      return isAssignedEmployee(assignedTo)
        && userHasPerm('orders', 'delete');
    }

    function employeeHasPricingView() {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('pricing', false), 'view');
    }

    function employeeHasPricingCreate() {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('pricing', false), 'create');
    }

    function employeeHasPricingEdit() {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('pricing', false), 'edit');
    }

    function employeeHasPricingDelete() {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('pricing', false), 'delete');
    }

    function employeeHasCustomersPerm(action) {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('customers', false), action);
    }

    function employeeHasQuotesPerm(action) {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('quotes', false), action);
    }

    function employeeHasProductsPerm(action) {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('products', false), action);
    }

    function employeeHasGalleryPerm(action) {
      return isActiveEmployee()
        && hasPerm(getEmployeePermissions().get('gallery', false), action);
    }

    // ─── Validações Estruturais e de Integridade de Dados no Servidor ─────────
    function canCreateOwnedModule(module) {
      return isAdmin() || userHasPerm(module, 'create');
    }

    // Avoid reevaluating isOwner(), isAdmin() and userHasPerm() independently
    // in each create rule. A single profile lookup keeps complex writes below
    // the Firestore Rules expression evaluation limit.
    function canCreateOwnedDocument(module, data) {
      let profile = get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
      return profile.get('active', true)
        && (!('tokensValidAfterTime' in profile) || request.auth.token.auth_time > profile.tokensValidAfterTime)
        && (
          profile.get('role', '') == 'admin'
          || (data.userId == request.auth.uid
            && hasPerm(profile.get('permissions', {}).get(module, false), 'create'))
        );
    }

    function canUpdateOrder(previous, changed) {
      let profile = get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
      let role = profile.get('role', '');
      return isActiveProfile(profile)
        && (
          role == 'admin'
          || (
            previous.userId == request.auth.uid
            && hasPerm(profile.get('permissions', {}).get('orders', false), 'edit')
            && (!changed.hasAny(['deletedAt'])
              || hasPerm(profile.get('permissions', {}).get('orders', false), 'delete')
              || hasPerm(profile.get('permissions', {}).get('archivedOrders', false), 'create'))
          )
          || (
            role == 'funcionario'
            && previous.get('assignedTo', '') == request.auth.uid
            && hasPerm(profile.get('permissions', {}).get('orders', false), 'edit')
            && !changed.hasAny(['assignedTo'])
            && (!changed.hasAny(['deletedAt'])
              || hasPerm(profile.get('permissions', {}).get('orders', false), 'delete'))
          )
        );
    }

    function canUpdateOwnedQuote(previous, next) {
      let profile = get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
      let role = profile.get('role', '');
      return isActiveProfile(profile)
        && (
          role == 'admin'
          || (
            (previous.userId == request.auth.uid || role == 'funcionario')
            && (!('userId' in next) || next.userId == previous.userId)
            && hasPerm(profile.get('permissions', {}).get('quotes', false), 'edit')
          )
        );
    }

    function isValidCalendarDate(value) {
      let parts = value.split('-');
      let m = int(parts[1]);
      let d = int(parts[2]);
      let dt = timestamp.date(int(parts[0]), m, d);
      return dt.month() == m && dt.day() == d;
    }

    // Direct required-field access and string methods fail closed for missing/wrong types.
    function isValidNewOrder(data) {
      return data.customerName.size() <= 200 && data.customerName.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.productName.size() <= 300 && data.productName.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && data.quantity is int && data.quantity > 0 && data.quantity <= 10000
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && data.status in ['pending', 'in-progress', 'completed', 'cancelled']
        && data.deliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isValidCalendarDate(data.deliveryDate)
        && (data.get('customerPhone', null) == null || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (data.get('notes', null) == null || (data.notes is string && data.notes.size() <= 1000))
        && (data.get('tags', null) == null || isValidOrderTags(data.tags))
        && (data.get('customerId', null) == null || (
          data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128
          && get(/databases/$(database)/documents/customers/$(data.customerId)).data.userId == data.userId
        ))
        && isValidOrderItemsField(data)
        && (data.get('payment', null) == null || isConsistentOrderPayment(data.payment, data.price));
    }

    // Tag names are trimmed before submission; reject NUL in either field.
    function isValidOrderTag(tag) {
      // The separator cannot occur inside either field, so the regex validates
      // the name and color independently without ambiguous concatenation.
      return tag.size() == 2
        && (tag.name + '\u0000' + tag.color).matches('^[^\\s\u0000]([^\u0000]{0,78}[^\\s\u0000])?\u0000#[a-fA-F0-9]{6}([a-fA-F0-9]{2})?$');
    }

    function are5TagsValid(t0, t1, t2, t3, t4) {
      return (t0.size() + t1.size() + t2.size() + t3.size() + t4.size()) == 10
        && (t0.name + '\u0000' + t0.color + '\n'
          + t1.name + '\u0000' + t1.color + '\n'
          + t2.name + '\u0000' + t2.color + '\n'
          + t3.name + '\u0000' + t3.color + '\n'
          + t4.name + '\u0000' + t4.color)
          .matches('^([^\\s\u0000\n]([^\u0000\n]{0,78}[^\\s\u0000\n])?\u0000#[a-fA-F0-9]{6}([a-fA-F0-9]{2})?\n){4}[^\\s\u0000\n]([^\u0000\n]{0,78}[^\\s\u0000\n])?\u0000#[a-fA-F0-9]{6}([a-fA-F0-9]{2})?$');
    }

    function are20TagsValid(tags) {
      return are5TagsValid(tags[0], tags[1], tags[2], tags[3], tags[4])
        && are5TagsValid(tags[5], tags[6], tags[7], tags[8], tags[9])
        && are5TagsValid(tags[10], tags[11], tags[12], tags[13], tags[14])
        && are5TagsValid(tags[15], tags[16], tags[17], tags[18], tags[19]);
    }

    function isValidOrderTags(tags) {
      let count = tags.size();
      return tags is list && count <= 20
        && (count == 20 ? are20TagsValid(tags) : (
          (count <= 0 || isValidOrderTag(tags[0]))
          && (count <= 1 || isValidOrderTag(tags[1]))
          && (count <= 2 || isValidOrderTag(tags[2]))
          && (count <= 3 || isValidOrderTag(tags[3]))
          && (count <= 4 || isValidOrderTag(tags[4]))
          && (count <= 5 || isValidOrderTag(tags[5]))
          && (count <= 6 || isValidOrderTag(tags[6]))
          && (count <= 7 || isValidOrderTag(tags[7]))
          && (count <= 8 || isValidOrderTag(tags[8]))
          && (count <= 9 || isValidOrderTag(tags[9]))
          && (count <= 10 || isValidOrderTag(tags[10]))
          && (count <= 11 || isValidOrderTag(tags[11]))
          && (count <= 12 || isValidOrderTag(tags[12]))
          && (count <= 13 || isValidOrderTag(tags[13]))
          && (count <= 14 || isValidOrderTag(tags[14]))
          && (count <= 15 || isValidOrderTag(tags[15]))
          && (count <= 16 || isValidOrderTag(tags[16]))
          && (count <= 17 || isValidOrderTag(tags[17]))
          && (count <= 18 || isValidOrderTag(tags[18]))
          && (count <= 19 || isValidOrderTag(tags[19]))
        ));
    }

    function are20TagsValidUpdate(tags, prevTags) {
      return (tags[0] == prevTags[0] || isValidOrderTag(tags[0]))
        && (tags[1] == prevTags[1] || isValidOrderTag(tags[1]))
        && (tags[2] == prevTags[2] || isValidOrderTag(tags[2]))
        && (tags[3] == prevTags[3] || isValidOrderTag(tags[3]))
        && (tags[4] == prevTags[4] || isValidOrderTag(tags[4]))
        && (tags[5] == prevTags[5] || isValidOrderTag(tags[5]))
        && (tags[6] == prevTags[6] || isValidOrderTag(tags[6]))
        && (tags[7] == prevTags[7] || isValidOrderTag(tags[7]))
        && (tags[8] == prevTags[8] || isValidOrderTag(tags[8]))
        && (tags[9] == prevTags[9] || isValidOrderTag(tags[9]))
        && (tags[10] == prevTags[10] || isValidOrderTag(tags[10]))
        && (tags[11] == prevTags[11] || isValidOrderTag(tags[11]))
        && (tags[12] == prevTags[12] || isValidOrderTag(tags[12]))
        && (tags[13] == prevTags[13] || isValidOrderTag(tags[13]))
        && (tags[14] == prevTags[14] || isValidOrderTag(tags[14]))
        && (tags[15] == prevTags[15] || isValidOrderTag(tags[15]))
        && (tags[16] == prevTags[16] || isValidOrderTag(tags[16]))
        && (tags[17] == prevTags[17] || isValidOrderTag(tags[17]))
        && (tags[18] == prevTags[18] || isValidOrderTag(tags[18]))
        && (tags[19] == prevTags[19] || isValidOrderTag(tags[19]));
    }

    function isValidOrderTagsUpdate(tags, previous) {
      let prevTags = previous.get('tags', []);
      let count = tags.size();
      let prevCount = prevTags is list ? prevTags.size() : 0;
      return tags is list && count <= 20
        && (tags == prevTags
          || (count == 20 && prevCount == 20
            ? (tags[0] == prevTags[0] || tags[19] == prevTags[19]
              ? are20TagsValidUpdate(tags, prevTags)
              : are20TagsValid(tags))
            : isValidOrderTags(tags)));
    }

    function isValidOrderItem(item) {
      return item is map
        && 'name' in item && 'quantity' in item && 'unitPrice' in item
        && item.size() == ('price' in item ? 4 : 3)
        && item.name.size() <= 300 && item.name.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && item.quantity is int && item.quantity > 0 && item.quantity <= 10000
        && item.unitPrice >= 0 && item.unitPrice <= 1000000
        && (!('price' in item) || math.abs(item.price - (item.quantity * item.unitPrice)) < 0.05);
    }

    function isValidOrderItems(items) {
      let count = items.size();
      return items is list && count > 0 && count <= 10
        && (count == 1 ? isValidOrderItem(items[0]) : (
          isValidOrderItem(items[0])
          && (count <= 1 || isValidOrderItem(items[1]))
          && (count <= 2 || isValidOrderItem(items[2]))
          && (count <= 3 || isValidOrderItem(items[3]))
          && (count <= 4 || isValidOrderItem(items[4]))
          && (count <= 5 || isValidOrderItem(items[5]))
          && (count <= 6 || isValidOrderItem(items[6]))
          && (count <= 7 || isValidOrderItem(items[7]))
          && (count <= 8 || isValidOrderItem(items[8]))
          && (count <= 9 || isValidOrderItem(items[9]))
        ));
    }

    function getItemSubtotal(item) {
      return 'price' in item ? item.price : (item.quantity * item.unitPrice);
    }

    function isConsistentOrderItemsSum(items, quantity, price) {
      let count = items.size();
      return (count == 1 && quantity == items[0].quantity && math.abs(price - getItemSubtotal(items[0])) < 0.05)
        || (count == 2 && quantity == (items[0].quantity + items[1].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]))) < 0.05)
        || (count == 3 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]))) < 0.05)
        || (count == 4 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]))) < 0.05)
        || (count == 5 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]))) < 0.05)
        || (count == 6 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]) + getItemSubtotal(items[5]))) < 0.05)
        || (count == 7 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]) + getItemSubtotal(items[5]) + getItemSubtotal(items[6]))) < 0.05)
        || (count == 8 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity + items[7].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]) + getItemSubtotal(items[5]) + getItemSubtotal(items[6]) + getItemSubtotal(items[7]))) < 0.05)
        || (count == 9 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity + items[7].quantity + items[8].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]) + getItemSubtotal(items[5]) + getItemSubtotal(items[6]) + getItemSubtotal(items[7]) + getItemSubtotal(items[8]))) < 0.05)
        || (count == 10 && quantity == (items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity + items[7].quantity + items[8].quantity + items[9].quantity)
            && math.abs(price - (getItemSubtotal(items[0]) + getItemSubtotal(items[1]) + getItemSubtotal(items[2]) + getItemSubtotal(items[3]) + getItemSubtotal(items[4]) + getItemSubtotal(items[5]) + getItemSubtotal(items[6]) + getItemSubtotal(items[7]) + getItemSubtotal(items[8]) + getItemSubtotal(items[9]))) < 0.05);
    }

    function isConsistentOrderItemsMetadata(items, data) {
      let count = items.size();
      let up = data.get('unitPrice', null);
      return (count > 1 ? up == null : (
        up == null || math.abs(up - items[0].unitPrice) < 0.01
      ));
    }

    function isValidOrderItemsField(data) {
      let items = data.get('items', null);
      let mode = data.get('pricingMode', null);
      let unitPrice = data.get('unitPrice', null);
      return (mode == null || mode == 'unit' || mode == 'total' || mode == 'items')
        && (unitPrice == null || (unitPrice is number && unitPrice >= 0 && unitPrice <= 1000000))
        && (items == null || (
          isValidOrderItems(items)
          && isConsistentOrderItemsSum(items, data.quantity, data.price)
          && isConsistentOrderItemsMetadata(items, data)
        ));
    }

    function isValidOrderConcurrency(previous, next, changed) {
      // Legacy orders without a version start at 1; every real update must advance it once.
      return changed.size() == 0
        || next.version == previous.get('version', 1) + 1;
    }

    function isConsistentOrderPayment(payment, price) {
      let paid = payment.paidAmount;
      let remaining = payment.remainingAmount;
      let status = payment.status;
      let method = payment.get('method', null);
      return payment.totalAmount == price
        && paid is number && paid >= 0 && paid <= price
        && remaining >= 0
        && math.abs(remaining - (price - paid)) < 0.005
        && (method == null || method == 'pix' || method == 'cash' || method == 'credit' || method == 'debit' || method == 'transfer')
        && (status == 'paid' ? paid == price
          : status == 'partial' ? (paid > 0 && paid < price)
          : status == 'pending' && paid == 0);
    }

    function isValidOrder(data, changed) {
      return (!changed.hasAny(['price']) || (data.price is number && data.price >= 0 && data.price <= 1000000))
        && (!changed.hasAny(['quantity']) || (data.quantity is int && data.quantity > 0 && data.quantity <= 10000))
        && (!changed.hasAny(['customerName']) || (data.customerName.size() <= 200 && data.customerName.matches('[\\s\\S]*[^\\s][\\s\\S]*')))
        && (!changed.hasAny(['productName']) || (data.productName.size() <= 300 && data.productName.matches('[\\s\\S]*[^\\s][\\s\\S]*')))
        && (!changed.hasAny(['customerPhone']) || data.get('customerPhone', null) == null || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!changed.hasAny(['notes']) || data.get('notes', null) == null || (data.notes is string && data.notes.size() <= 1000))
        && (!changed.hasAny(['status']) || data.status in ['pending', 'in-progress', 'completed', 'cancelled']);
    }

    function isValidOrderChanges(previous, data, changed) {
      return isValidOrder(data, changed)
        && (!changed.hasAny(['tags']) || data.get('tags', null) == null || isValidOrderTagsUpdate(data.tags, previous))
        && (!changed.hasAny(['deliveryDate']) || (
          data.deliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isValidCalendarDate(data.deliveryDate)))
        && (!changed.hasAny(['customerId']) || data.get('customerId', null) == null || (
          data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128
          && get(/databases/$(database)/documents/customers/$(data.customerId)).data.userId == data.userId))
        && ((!changed.hasAny(['items', 'pricingMode', 'unitPrice']) && (data.get('items', null) == null || !changed.hasAny(['price', 'quantity'])))
          || isValidOrderItemsField(data))
        && (!changed.hasAny(['price', 'payment']) || data.get('payment', null) == null || isConsistentOrderPayment(data.payment, data.price));
    }

    function isAllowedOrderUpdate(previous, next) {
      let changed = next.diff(previous).affectedKeys();
      return canUpdateOrder(previous, changed)
        && changed.hasOnly([
          'customerName', 'customerPhone', 'customerId', 'productName',
          'quantity', 'price', 'pricingMode', 'unitPrice', 'items', 'status',
          'deliveryDate', 'notes', 'tags', 'payment',
          'assignedTo', 'assignedToName', 'assignedAt', 'assignedBy', 'createdByName',
          'productionWorkflow', 'attachments',
          'isExchange', 'exchangeNotes', 'exchangeItems', 'cardColor',
          'realCost', 'version', 'isArchived', 'archivedAt', 'archivedBy',
          'deletedAt', 'updatedAt', 'requiresFinancialApproval', 'financialWarning',
          'shippingTagId', 'shippingStatus', 'shippingTrackingNumber',
          'shippingLabelUrl', 'shippingServiceId', 'shippingServiceName',
          'shippingCost', 'shippingUpdatedAt'
        ])
        && isValidOrderConcurrency(previous, next, changed)
        && isValidOrderChanges(previous, next, changed);
    }

    function isValidCustomer(data) {
      return (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (!('totalSpent' in data) || (data.totalSpent is number && data.totalSpent >= 0))
        && (!('totalOrders' in data) || (data.totalOrders is number && data.totalOrders >= 0));
    }

    function isValidSaleRecord(data) {
      return (!('amount' in data) || (data.amount is number && data.amount >= 0))
        && (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0))
        && (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0))
        && (!('quantity' in data) || (data.quantity is number && data.quantity > 0));
    }

    function itemValidTotal(item) {
      let p = item.unitPrice * 100;
      return (
        item.size() == 3
        && item.quantity is int && item.quantity >= 1 && item.quantity <= 10000
        && item.unitPrice >= 0 && item.unitPrice <= 1000000
        && math.round(p) == p
        && item.name.size() <= 300 && item.name.matches('[\\s\\S]*[^\\s][\\s\\S]*')
      ) ? item.quantity * item.unitPrice : -1000000000000000;
    }

    function quoteSubtotal(items) {
      let c = items.size();
      let s1 = itemValidTotal(items[0])
        + (c > 1 ? itemValidTotal(items[1]) : 0)
        + (c > 2 ? itemValidTotal(items[2]) : 0)
        + (c > 3 ? itemValidTotal(items[3]) : 0)
        + (c > 4 ? itemValidTotal(items[4]) : 0);
      return c <= 5 ? s1 : s1
        + itemValidTotal(items[5])
        + (c > 6 ? itemValidTotal(items[6]) : 0)
        + (c > 7 ? itemValidTotal(items[7]) : 0)
        + (c > 8 ? itemValidTotal(items[8]) : 0)
        + (c > 9 ? itemValidTotal(items[9]) : 0);
    }

    function isValidQuoteMath(data) {
      let items = data.get('items', []);
      let count = items.size();
      let subtotal = (items is list && count >= 1 && count <= 10) ? quoteSubtotal(items) : -1;
      let disc = data.get('discount', 0);
      let discount = disc == null ? 0 : disc;
      let dt = data.get('discountType', 'percent');
      let discountType = dt == null ? 'percent' : dt;
      let discountAmount = discountType == 'percent' ? subtotal * discount / 100 : discount;
      let dCents = discount * 100;
      return subtotal >= 0
        && discount >= 0
        && math.round(dCents) == dCents
        && (discountType in ['percent', 'fixed'])
        && (discountType != 'percent' || discount <= 100)
        && discountAmount <= subtotal
        && data.totalPrice >= 0
        && math.abs(data.totalPrice - (subtotal - discountAmount)) < 0.0051;
    }

    function isValidQuote(data) {
      let name = data.get('customerName', '');
      return name.size() >= 1 && name.size() <= 200
        && data.get('status', 'draft') in ['draft', 'sent', 'approved', 'rejected', 'expired']
        && isValidQuoteMath(data);
    }

    function isValidQuoteUpdate(data, previous) {
      let name = data.get('customerName', '');
      return (!('totalPrice' in data) || (data.totalPrice is number && data.totalPrice >= 0))
        && (!('customerName' in data) || (name is string && name.size() >= 1 && name.size() <= 200))
        && (!('status' in data) || data.status in ['draft', 'sent', 'approved', 'rejected', 'expired'])
        && (!data.diff(previous).affectedKeys().hasAny(['items', 'totalPrice', 'discount', 'discountType'])
          || (('items' in data) && isValidQuoteMath(data)));
    }

    function isValidProduct(data) {
      return (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0))
        && (!('price' in data) || (data.price is number && data.price >= 0))
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200));
    }

    function isValidSupply(data) {
      return (!('purchasePrice' in data) || (data.purchasePrice is number && data.purchasePrice >= 0))
        && (!('unitCost' in data) || (data.unitCost is number && data.unitCost >= 0))
        && (!('packageQuantity' in data) || (data.packageQuantity is number && data.packageQuantity > 0))
        && (!('currentStock' in data) || (data.currentStock is number && data.currentStock >= 0 && data.currentStock <= 1000000000))
        && (!('minStock' in data) || (data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000000))
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200));
    }

    function isValidGalleryItem(data) {
      return (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048));
    }

    function isValidRecipe(data) {
      return (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 200))
        && (!('finalPrice' in data) || (data.finalPrice is number && data.finalPrice >= 0));
    }

    function isValidPurchase(data) {
      return (!('purchasePrice' in data) || (data.purchasePrice is number && data.purchasePrice >= 0))
        && (!('packageQuantity' in data) || (data.packageQuantity is number && data.packageQuantity > 0));
    }

    // Regras para pedidos (orders)
    match /orders/{orderId} {
      allow read: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('orders', 'view'))
        || isAdmin()
        || (resource != null && 'assignedTo' in resource.data && isAssignedEmployee(resource.data.assignedTo) && userHasPerm('orders', 'view'));
      allow create: if request.auth != null
        && canCreateOwnedDocument('orders', request.resource.data)
        && isValidNewOrder(request.resource.data);
      allow update: if request.auth != null
        && isAllowedOrderUpdate(resource.data, request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('orders', 'delete'))
        || isAdmin()
        || (resource != null && 'assignedTo' in resource.data && isAssignedEmployeeDeleter(resource.data.assignedTo));
    }

    // Regras para histórico financeiro de vendas (salesLedger)
    match /salesLedger/{saleId} {
      allow read: if request.auth != null && (
        (resource != null && (
          ('userId' in resource.data && isOwner(resource.data.userId))
          || isAdmin()
          || ('assignedTo' in resource.data && isAssignedEmployee(resource.data.assignedTo))
        ))
        || (resource == null && (
          isAdmin()
          || (
            exists(/databases/$(database)/documents/orders/$(saleId))
            && (
              isOwner(get(/databases/$(database)/documents/orders/$(saleId)).data.get('userId', ''))
              || ('assignedTo' in get(/databases/$(database)/documents/orders/$(saleId)).data && isAssignedEmployee(get(/databases/$(database)/documents/orders/$(saleId)).data.assignedTo))
            )
          )
        ))
      );
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId)) || isAdmin())
        && isValidSaleRecord(request.resource.data);
      allow update: if (isAdmin() || (
        resource != null
        && 'userId' in resource.data
        && 'userId' in request.resource.data
        && request.resource.data.userId == resource.data.userId
        && (isOwner(resource.data.userId) || (
          'assignedTo' in resource.data
          && isAssignedEmployeeEditor(resource.data.assignedTo)
          && ('assignedTo' in request.resource.data && request.resource.data.assignedTo == resource.data.assignedTo)
        ))
      )) && isValidSaleRecord(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin();
    }

    // Regras para resumos mensais consolidados de vendas (salesMonthlySummaries)
    match /salesMonthlySummaries/{summaryId} {
      allow read: if request.auth != null && (
        (resource != null && (
          ('userId' in resource.data && isOwner(resource.data.userId))
          || isAdmin()
        ))
        || (resource == null && (isAdmin() || isActiveUser()))
      );
      allow create: if ('userId' in request.resource.data && isOwner(request.resource.data.userId)) || isAdmin();
      allow update: if isAdmin() || (
        resource != null
        && 'userId' in resource.data
        && 'userId' in request.resource.data
        && request.resource.data.userId == resource.data.userId
        && isOwner(resource.data.userId)
      );
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId))
        || isAdmin();
    }

    // Regras para clientes (customers)
    match /customers/{customerId} {
      allow read: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('customers', 'view'))
        || isAdmin()
        || employeeHasCustomersPerm('view');
      allow create: if request.auth != null
        && canCreateOwnedDocument('customers', request.resource.data)
        && ('name' in request.resource.data && request.resource.data.name is string && request.resource.data.name.matches('[\\s\\S]*[^\\s][\\s\\S]*'))
        && (request.resource.data.get('email', null) == null || (request.resource.data.email is string && request.resource.data.email.size() <= 254 && (request.resource.data.email.size() == 0 || request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))))
        && (request.resource.data.get('notes', null) == null || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && isValidCustomer(request.resource.data);
      allow update: if (
        isAdmin()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('customers', 'edit'))
        || employeeHasCustomersPerm('edit')
      ) && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
        && isValidCustomer(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('customers', 'delete'))
        || isAdmin()
        || employeeHasCustomersPerm('delete');
    }

    // Regras para orçamentos (quotes)
    match /quotes/{quoteId} {
      allow read: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('quotes', 'view'))
        || isAdmin()
        || employeeHasQuotesPerm('view');
      allow create: if request.auth != null
        && canCreateOwnedDocument('quotes', request.resource.data)
        && isValidQuote(request.resource.data);
      allow update: if request.auth != null
        && resource != null
        && canUpdateOwnedQuote(resource.data, request.resource.data)
        && isValidQuoteUpdate(request.resource.data, resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('quotes', 'delete'))
        || isAdmin()
        || employeeHasQuotesPerm('delete');
    }

    // Regras para produtos (products)
    match /products/{productId} {
      allow read: if (resource != null && 'isPublic' in resource.data && resource.data.isPublic == true)
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('products', 'view'))
        || isAdmin()
        || employeeHasProductsPerm('view');
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId) && canCreateOwnedModule('products')) || isAdmin())
        && isValidProduct(request.resource.data);
      allow update: if (
        isAdmin()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('products', 'edit'))
        || employeeHasProductsPerm('edit')
      ) && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
        && isValidProduct(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('products', 'delete'))
        || isAdmin()
        || employeeHasProductsPerm('delete');
    }

    // Regras para galeria de artes (gallery)
    match /gallery/{itemId} {
      allow read: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('gallery', 'view'))
        || isAdmin()
        || employeeHasGalleryPerm('view');
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId) && userHasPerm('gallery', 'create'))
        || isAdmin()
        || employeeHasGalleryPerm('create')) && isValidGalleryItem(request.resource.data);
      allow update: if (
        isAdmin()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('gallery', 'delete'))
        || employeeHasGalleryPerm('delete')
      ) && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
        && isValidGalleryItem(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('gallery', 'delete'))
        || isAdmin()
        || employeeHasGalleryPerm('delete');
    }

    // Regras para configurações de usuário (users)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Regras para insumos e matérias-primas (supplies)
    match /supplies/{supplyId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'view'))
      );
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId) && userHasPerm('pricing', 'create')) || isAdmin() || employeeHasPricingCreate())
        && isValidSupply(request.resource.data);
      allow update: if ((resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'edit')) || isAdmin() || employeeHasPricingEdit())
        && isValidSupply(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'delete')) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para histórico de compras de insumos (purchaseHistory)
    match /purchaseHistory/{purchaseId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'view'))
        || (resource == null && purchaseId.matches('^' + request.auth.uid + '_.*') && userHasPerm('pricing', 'view'))
      );
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId) && userHasPerm('pricing', 'create')) || isAdmin() || employeeHasPricingCreate())
        && isValidPurchase(request.resource.data);
      allow update: if ((resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'edit')) || isAdmin() || employeeHasPricingEdit())
        && isValidPurchase(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'delete')) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para fichas técnicas de precificação (pricingRecipes)
    match /pricingRecipes/{recipeId} {
      allow read: if request.auth != null && (
        isAdmin()
        || employeeHasPricingView()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'view'))
      );
      allow create: if (('userId' in request.resource.data && isOwner(request.resource.data.userId) && userHasPerm('pricing', 'create')) || isAdmin() || employeeHasPricingCreate())
        && isValidRecipe(request.resource.data);
      allow update: if ((resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'edit')) || isAdmin() || employeeHasPricingEdit())
        && isValidRecipe(request.resource.data);
      allow delete: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'delete')) || isAdmin() || employeeHasPricingDelete();
    }

    // Regras para configurações do ateliê (pricingSettings)
    match /pricingSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin() || employeeHasPricingView();
      allow write: if isOwner(userId) || isAdmin() || employeeHasPricingEdit();
    }

    // Regras para acompanhamento de produção (productionTracking)
    match /productionTracking/{trackingId} {
      allow read: if (resource != null && 'userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'view'))
        || isAdmin()
        || employeeHasPricingView();
      allow create: if ('userId' in request.resource.data && 'recipeId' in request.resource.data)
        && request.resource.data.userId is string
        && request.resource.data.recipeId is string
        && (('userId' in request.resource.data && isOwner(request.resource.data.userId) && userHasPerm('pricing', 'create')) || isAdmin() || employeeHasPricingCreate());
      allow update: if resource != null && 'userId' in resource.data && (
        ('userId' in request.resource.data && request.resource.data.userId == resource.data.userId && isOwner(resource.data.userId) && userHasPerm('pricing', 'edit'))
        || isAdmin()
        || (
          'userId' in request.resource.data && request.resource.data.userId == resource.data.userId
          && employeeHasPricingEdit()
        )
      );
      allow delete: if resource != null && (
        ('userId' in resource.data && isOwner(resource.data.userId) && userHasPerm('pricing', 'delete'))
        || isAdmin()
        || employeeHasPricingDelete()
      );
    }

    // Perfis de usuário do sistema de permissões
    match /userProfiles/{uid} {
      // Leitura: usuário lê sempre o próprio perfil (mesmo inativo ou por e-mail correspondente);
      // admin e funcionários ativos leem todos para colaboração na equipe
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email)
        || (isActiveUser() && (isAdmin() || userHasPerm('users', 'view')))
      );

      // Criação: somente Cloud Functions (Admin SDK).
      allow create: if false;

      // Alterações administrativas passam pela callable updateUser, que valida
      // o último administrador e registra auditoria.
      allow update: if isActiveUser()
        && request.auth.uid == uid
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'whatsappPhone']);

      // Deleção: somente Cloud Functions (Admin SDK).
      allow delete: if false;

      match /devices/{deviceId} {
        // Leitura para monitorar a própria sessão (kicks) e para admins verem a lista
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if false; // Criação/Deleção via Cloud Functions
      }
    }

    // Permissões explícitas; perfis legados sem emails não recebem acesso.
    function canAccessEmails(action) {
      return isActiveUser() && (isAdmin()
        || hasPerm(getEmployeePermissions().get('emails', false), action));
    }

    function validEmailStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'starred', 'archived', 'trashed', 'trashedAt', 'spam', 'spamScore', 'spamReasons'])
        && request.resource.data.get('read', false) is bool
        && request.resource.data.get('starred', false) is bool
        && request.resource.data.get('archived', false) is bool
        && request.resource.data.get('trashed', false) is bool
        && (!('spam' in request.resource.data) || request.resource.data.get('spam', false) is bool)
        && (!('spamScore' in request.resource.data) || request.resource.data.spamScore is number)
        && (!('spamReasons' in request.resource.data) || request.resource.data.spamReasons is list)
        && (request.resource.data.get('trashed', false) == false
          ? request.resource.data.get('trashedAt', null) == null
          : request.resource.data.get('trashedAt', null) is timestamp);
    }

    function validSentEmailStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['trashed', 'trashedAt'])
        && request.resource.data.get('trashed', false) is bool
        && (request.resource.data.get('trashed', false) == false
          ? request.resource.data.get('trashedAt', null) == null
          : request.resource.data.get('trashedAt', null) is timestamp);
    }

    match /receivedEmails/{emailId} {
      allow read: if canAccessEmails('view');
      allow create: if false;
      allow update: if (canAccessEmails('edit') || canAccessEmails('delete')) && validEmailStatusUpdate();
      allow delete: if canAccessEmails('delete');
    }

    match /sentEmails/{emailId} {
      allow read: if canAccessEmails('view');
      allow create: if false;
      allow update: if (canAccessEmails('edit') || canAccessEmails('delete')) && validSentEmailStatusUpdate();
      allow delete: if canAccessEmails('delete');
    }

    // Regras para configurações públicas da loja / catálogo online
    match /storeSettings/{docId} {
      allow read: if true;
      // Escrita restrita a administradores ou usuários ativos com permissão explícita de loja ou configurações
      allow write: if isActiveUser() && (
        isAdmin()
        || getEmployeePermissions().get('store', false) == true
        || getEmployeePermissions().get('settings', false) == true
      );
    }

    // Regras para catálogo de produtos da lojinha pública (storeProducts)
    match /storeProducts/{productId} {
      allow read: if true;

      // Criação permitida para administradores ou usuários ativos com permissão de criação em loja
      allow create: if isActiveUser() && (
        isAdmin()
        || ('storeProducts' in getEmployeePermissions() && hasPerm(getEmployeePermissions().storeProducts, 'create'))
        || getEmployeePermissions().get('store', false) == true
      ) && isValidProduct(request.resource.data);

      // Atualização permitida para administradores, donos do produto ou usuários com permissão
      allow update: if isActiveUser() && (
        isAdmin()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId))
        || ('storeProducts' in getEmployeePermissions() && hasPerm(getEmployeePermissions().storeProducts, 'edit'))
        || getEmployeePermissions().get('store', false) == true
      ) && isValidProduct(request.resource.data);

      // Exclusão permitida para administradores, donos do produto ou usuários ativos com permissão de exclusão
      allow delete: if isActiveUser() && (
        isAdmin()
        || (resource != null && 'userId' in resource.data && isOwner(resource.data.userId))
        || ('storeProducts' in getEmployeePermissions() && hasPerm(getEmployeePermissions().storeProducts, 'delete'))
        || getEmployeePermissions().get('store', false) == true
      );
    }

    // Regras para histórico de pedidos da Lojinha Pública (catalogOrders)
    // Criação aberta ao público ocorre via Cloud Function submitPublicCatalogOrder (Admin SDK)
    match /catalogOrders/{orderId} {
      // Bloquear criação direta no cliente por qualquer usuário; pedidos públicos devem passar estritamente pela Cloud Function submitPublicCatalogOrder
      allow create: if false;

      // Leitura permitida para administradores ou membros autorizados com permissão explícita de loja
      allow read: if isActiveUser() && (
        isAdmin()
        || getEmployeePermissions().get('store', false) == true
      );

      // Atualização e exclusão restritas a administradores ou gestores da loja
      allow update, delete: if isActiveUser() && (
        isAdmin()
        || getEmployeePermissions().get('store', false) == true
      );
    }

    // Regras para Central de Atendimento WhatsApp (whatsapp_chats e whatsapp_messages)
    function canAccessWhatsApp() {
      return isActiveUser() && (
        isAdmin()
        || (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', 'user') == 'user'
          && getEmployeePermissions().get('whatsapp', false) == true
        )
        || (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'funcionario'
          && getEmployeePermissions().get('whatsapp', false) == true
        )
      );
    }

    match /whatsapp_chats/{chatId} {
      allow read: if canAccessWhatsApp() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;
    }

    match /whatsapp_messages/{messageId} {
      allow read: if canAccessWhatsApp() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;
    }

    // Chaves de idempotência: somente Cloud Functions (Admin SDK) acessa esta coleção.
    match /whatsappSendRequests/{requestKey} {
      allow read, write: if false;
    }

    // Chaves de idempotência e webhooks de e-mail: somente Cloud Functions (Admin SDK)
    match /emailSendRequests/{requestKey} {
      allow read, write: if false;
    }
    match /processedEmailWebhooks/{webhookId} {
      allow read, write: if false;
    }

    // ─── Integração Alexa (Coleções Técnicas Internas) ────────────────────────
    // Bloqueio total de leitura e escrita direta pelo SDK cliente web/mobile.
    // Todas as operações devem passar exclusivamente por Cloud Functions v2 (Admin SDK).
    match /integrationSettings/alexa {
      allow read, write: if false;
    }
    match /alexaPermissions/{uid} {
      allow read, write: if false;
    }
    match /alexaBindings/{bindingKey} {
      allow read, write: if false;
    }
    match /alexaPairings/{codeHmac} {
      allow read, write: if false;
    }
    match /alexaDrafts/{draftId} {
      allow read, write: if false;
    }
    match /alexaRequests/{requestKey} {
      allow read, write: if false;
    }
    match /alexaCommits/{draftId} {
      allow read, write: if false;
    }
    match /alexaRateLimits/{bucketKey} {
      allow read, write: if false;
    }
    match /alexaAudit/{eventId} {
      allow read, write: if false;
    }

    // ─── Integração MCP & ChatGPT Actions (Coleções Técnicas Internas) ────────
    // Bloqueio total de leitura e escrita direta pelo SDK cliente web/mobile.
    // Todas as operações devem passar exclusivamente por Cloud Functions v2 (Admin SDK).
    match /integrationSettings/mcp {
      allow read, write: if false;
    }
    match /mcpApiKeys/{keyHash} {
      allow read, write: if false;
    }
    match /mcpIdempotency/{operationKey} {
      allow read, write: if false;
    }
    match /mcpAuditLogs/{eventId} {
      allow read, write: if false;
    }
    match /oauthClients/{clientId} {
      allow read, write: if false;
    }
    match /oauthAuthorizationRequests/{requestId} {
      allow read, write: if false;
    }
    match /oauthAuthCodes/{code} {
      allow read, write: if false;
    }
    match /oauthAccessTokens/{tokenId} {
      allow read, write: if false;
    }
    match /oauthRefreshTokens/{tokenId} {
      allow read, write: if false;
    }
    match /oauthSessions/{sessionId} {
      allow read, write: if false;
    }
    match /oauthRateLimits/{bucketId} {
      allow read, write: if false;
    }
  }
}
