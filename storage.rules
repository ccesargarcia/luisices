rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveUser() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('active', true) == true
        && (!('tokensValidAfterTime' in firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data)
            || request.auth.token.auth_time > firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.tokensValidAfterTime);
    }

    // Helper functions para controle de acesso granular
    function isAdmin() {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isActiveEmployee() {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'funcionario';
    }

    function getEmployeePermissions() {
      return firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('permissions', {});
    }

    function hasPerm(permField, action) {
      return (permField is map && permField.get(action, false) == true)
        || (permField is bool && permField == true);
    }

    function ownerHasPerm(userId, module, action) {
      return request.auth.uid == userId
        && ((!(module in getEmployeePermissions()) || hasPerm(getEmployeePermissions()[module], action))
          || (module == 'gallery' && action == 'edit' && legacyGalleryEditPerm()));
    }

    // Compatibilidade temporária com perfis legados sem gallery.edit.
    // Não concede edição a funcionários nem quando edit foi explicitamente revogado.
    function legacyGalleryEditPerm() {
      let profile = firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data;
      let permissions = profile.get('permissions', {});
      let gallery = permissions.get('gallery', false);
      return profile.get('role', '') != 'funcionario'
        && gallery is map
        && !('edit' in gallery)
        && hasPerm(gallery, 'create');
    }

    function canViewOrders() {
      return isActiveUser() && (isAdmin() || (isActiveEmployee() && ('orders' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().orders, 'view')));
    }

    function canViewGallery() {
      return isActiveUser() && (
        isAdmin()
        || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'view'))
      );
    }

    function canAccessEmailAttachments(action) {
      return isActiveUser() && (isAdmin()
        || hasPerm(getEmployeePermissions().get('emails', false), action));
    }

    // Rascunhos privados. O backend envia cópias como anexos reais da mensagem.
    match /users/{userId}/orders/email_draft/{allPaths=**} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isAdmin());
      allow create, update: if canAccessEmailAttachments('create')
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType == 'application/pdf');
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/emails/{allPaths=**} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isAdmin());
      allow create, update: if canAccessEmailAttachments('create')
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType == 'application/pdf');
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // Anexos recebidos/legados: escrita exclusivamente pelo backend.
    match /emails/{allPaths=**} {
      allow read: if canAccessEmailAttachments('view');
      allow write: if false;
    }

    // A regra genérica não pode reabrir os rascunhos: regras sobrepostas usam OR.
    // Anexos de pedidos pertencem ao tenant ({userId}). Acesso restrito ao dono, admin ou funcionário autorizado.
    match /users/{userId}/orders/{orderId}/{allPaths=**} {
      allow read: if orderId != 'email_draft' && isActiveUser()
        && (ownerHasPerm(userId, 'orders', 'view') || isAdmin() || (isActiveEmployee() && ('orders' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().orders, 'view')));
      allow create: if orderId != 'email_draft' && isActiveUser()
        && resource == null
        && (ownerHasPerm(userId, 'orders', 'create') || isAdmin() || (isActiveEmployee() && ('orders' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().orders, 'create')))
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType == 'application/pdf');
      allow update: if orderId != 'email_draft' && isActiveUser()
        && resource != null
        && (ownerHasPerm(userId, 'orders', 'edit') || isAdmin() || (isActiveEmployee() && ('orders' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().orders, 'edit')))
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType == 'application/pdf');
      allow delete: if orderId != 'email_draft' && isActiveUser()
        && (ownerHasPerm(userId, 'orders', 'delete') || isAdmin() || (isActiveEmployee() && ('orders' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().orders, 'delete')));
    }

    // Galeria de artes: apenas imagens, até 15MB
    match /users/{userId}/gallery/{fileName} {
      allow read: if isActiveUser() && (ownerHasPerm(userId, 'gallery', 'view') || canViewGallery());
      allow create: if isActiveUser() && resource == null && (ownerHasPerm(userId, 'gallery', 'create') || isAdmin() || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'create')))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update: if isActiveUser() && resource != null && (ownerHasPerm(userId, 'gallery', 'edit') || isAdmin() || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'edit')))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isActiveUser() && (ownerHasPerm(userId, 'gallery', 'delete') || isAdmin() || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'delete')));
    }

    // Imagens de perfil, logo e banner do usuário: leitura pública, edição restrita ao dono/admin
    match /users/{userId}/{folder}/{fileName} {
      allow read: if folder in ['avatar', 'logo', 'tracking-logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'];
      allow create, update: if folder in ['avatar', 'logo', 'tracking-logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser() && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && (folder != 'tracking-logo' || request.resource.contentType.matches('image/(jpeg|png|webp)'));
      allow delete: if folder in ['avatar', 'logo', 'tracking-logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'] && isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // Imagens e banners públicos da loja / catálogo: leitura pública, edição protegida
    match /store/{folder}/{fileName} {
      allow read: if true;
      allow create: if folder in ['products', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && (isAdmin() || (request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow update: if folder in ['products', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid && request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow delete: if folder in ['products', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser()
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid));
    }

    // Ativos e ícones estáticos públicos: leitura pública irrestrita
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
