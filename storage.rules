rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveUser() {
      return request.auth != null;
    }

    // Helper functions para controle de acesso granular
    function isAdmin() {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isActiveEmployee() {
      return isActiveUser()
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'funcionario';
    }

    function getEmployeePermissions() {
      return firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('permissions', {});
    }

    function hasPerm(permField, action) {
      return (permField is map && permField.get(action, false) == true)
        || (permField is bool && permField == true);
    }

    function canViewOrders() {
      return isActiveUser();
    }

    function canViewGallery() {
      return isActiveUser();
    }

    // Anexos de e-mails e rascunhos de envio: leitura pública para que o destinatário do e-mail e a CDN acessem os arquivos sem exigir login
    match /users/{userId}/orders/email_draft/{allPaths=**} {
      allow read: if true;
      allow create, update: if isActiveUser() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isActiveUser();
    }

    // Anexos de e-mails diretos
    match /users/{userId}/emails/{allPaths=**} {
      allow read: if true;
      allow create, update: if isActiveUser() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isActiveUser();
    }

    // Anexos de e-mails na raiz
    match /emails/{allPaths=**} {
      allow read: if true;
      allow create, update: if isActiveUser() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isActiveUser();
    }

    // Anexos de pedidos gerais e thumbnails: imagens, HEIC/HEIF, PDFs, documentos até 100MB
    match /users/{userId}/orders/{orderId}/{allPaths=**} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isActiveUser();
    }

    // Galeria de artes: apenas imagens, até 15MB
    match /users/{userId}/gallery/{fileName} {
      allow read: if isActiveUser() && (request.auth.uid == userId || canViewGallery());
      allow create, update: if isActiveUser() && (request.auth.uid == userId || isAdmin() || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'create')))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin() || (isActiveEmployee() && ('gallery' in getEmployeePermissions()) && hasPerm(getEmployeePermissions().gallery, 'delete')));
    }

    // Imagens de perfil, logo e banner do usuário: leitura pública, edição restrita ao dono/admin
    match /users/{userId}/{folder}/{fileName} {
      allow read: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'];
      allow create, update: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser() && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'] && isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // Imagens e banners públicos da loja / catálogo: leitura pública, edição protegida
    match /store/{folder}/{fileName} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || (request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow update: if isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid && request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow delete: if isActiveUser()
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid));
    }

    // Ativos e ícones estáticos públicos: leitura pública irrestrita
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
