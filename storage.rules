rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/userProfiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.get('active', true) == true;
    }

    // Helper functions para controle de acesso granular
    function isAdmin() {
      return isActiveUser()
        && firestore.exists(/databases/(default)/documents/userProfiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveEmployee() {
      return isActiveUser()
        && firestore.exists(/databases/(default)/documents/userProfiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.role == 'funcionario'
        && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.active == true;
    }

    function canViewOrders() {
      return isActiveUser()
        && (isAdmin() || (isActiveEmployee() && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders.view == true));
    }

    function canViewGallery() {
      return isActiveUser()
        && (isAdmin() || (isActiveEmployee() && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.view == true));
    }

    // Anexos de pedidos e thumbnails: imagens ou PDFs, até 100MB
    // Leitura permitida para o dono do pedido, admin ou funcionários com permissão de visualização de pedidos
    match /users/{userId}/orders/{orderId}/{allPaths=**} {
      allow read: if isActiveUser() && (request.auth.uid == userId || canViewOrders());
      allow create, update: if isActiveUser() && (request.auth.uid == userId || isAdmin() || (isActiveEmployee() && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.permissions.orders.edit == true))
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // Galeria de artes: apenas imagens, até 15MB
    match /users/{userId}/gallery/{fileName} {
      allow read: if isActiveUser() && (request.auth.uid == userId || canViewGallery());
      allow create, update: if isActiveUser() && (request.auth.uid == userId || isAdmin() || (isActiveEmployee() && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.create == true))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isActiveUser() && (request.auth.uid == userId || isAdmin() || (isActiveEmployee() && firestore.get(/databases/(default)/documents/userProfiles/$(request.auth.uid)).data.permissions.gallery.delete == true));
    }

    // Imagens de perfil, logo e banner do usuário: leitura pública, edição restrita ao dono/admin
    match /users/{userId}/{folder}/{fileName} {
      allow read: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'];
      allow create, update: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about']
        && isActiveUser() && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if folder in ['avatar', 'logo', 'banner', 'products', 'customers', 'catalog-logo', 'catalog-banner', 'catalog-header', 'catalog-about'] && isActiveUser() && (request.auth.uid == userId || isAdmin());
    }

    // Imagens e banners públicos da loja / catálogo: leitura pública, edição protegida
    match /store/{folder}/{fileName} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || (request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow update: if isActiveUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid && request.resource.metadata != null && request.resource.metadata.userId == request.auth.uid));
      allow delete: if isActiveUser()
        && (isAdmin() || (resource.metadata != null && resource.metadata.userId == request.auth.uid));
    }
  }
}
